# --- Database (Supabase Postgres via Supavisor pooler — never the direct db.*.supabase.co host,
#     which is IPv6-only unless the paid IPv4 add-on is enabled; the pooler is IPv4 on every plan) ---

# Copy the exact strings from Supabase dashboard -> Connect -> Connection String (Session /
# Transaction mode dropdown). Do NOT hand-build the host: the "aws-<index>-<region>" prefix
# isn't derivable from the region name alone.
#
# sslmode MUST be `no-verify`, not `require`: `require` only encrypts (pg-connection-string
# leaves strict cert verification on), and fails with "self-signed certificate in certificate
# chain" against Supabase's pooler. `no-verify` is what actually disables that check.

# Supavisor TRANSACTION mode, port 6543.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=no-verify

# Local Postgres pool size (next dev, payload migrate). Ignored on Vercel, where the pool is
# always capped at 1 — see the comment on `pool.max` in src/payload.config.ts.
DATABASE_POOL_MAX=10

PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Supabase Storage (S3-compatible) ---
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=itu-web-media
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=<project-ref>.storage.supabase.co
