# --- Database (Postgres) ---

# Local dev / docker-compose (host port 5434 — see docker-compose.yml for why):
DATABASE_URI=postgresql://payload:payload@localhost:5434/payload

# On Cloud Run, DATABASE_URI is set via Secret Manager instead (see the deploy commands) and
# points at the Cloud SQL unix socket:
# postgresql://payload:<password>@/payload?host=/cloudsql/<project>:<region>:<instance>

# Pool size per instance — keep (DATABASE_POOL_MAX * Cloud Run --max-instances) under your
# Cloud SQL tier's connection limit. See the comment on `pool.max` in src/payload.config.ts.
DATABASE_POOL_MAX=10

PAYLOAD_SECRET=
SERVER_URL=http://localhost:3000

# --- Media storage (Google Cloud Storage) ---
# Unset -> Payload falls back to local disk uploads (./media). On Cloud Run this must be set,
# since the container's disk isn't persistent. Auth is via Application Default Credentials —
# the Cloud Run service account in production, `gcloud auth application-default login` locally.
GCS_BUCKET=itu-web-media

# Résumés are private (job applications), so they live in a separate bucket from public media —
# never expose it with allUsers/allAuthenticatedUsers. Required whenever GCS_BUCKET is set.
GCS_RESUME_BUCKET=itu-web-resumes
