# --- Database (Postgres) ---

# Local docker-compose DB (recommended): host port 5434, user/password/db all `payload`.
# See README "Local Docker". Native Postgres on 5432 only works if that instance has the
# matching role and database.
DATABASE_URI=postgresql://payload:payload@localhost:5434/payload

# On Cloud Run, DATABASE_URI is set via Secret Manager instead (see the deploy commands) and
# points at the Cloud SQL unix socket:
# postgresql://payload:<password>@/payload?host=/cloudsql/<project>:<region>:<instance>

# Pool size per instance — keep (DATABASE_POOL_MAX * Cloud Run --max-instances) under your
# Cloud SQL tier's connection limit. See the comment on `pool.max` in src/payload.config.ts.
DATABASE_POOL_MAX=10

# Required for local `bun dev` and for compose (compose falls back to a weak local-only
# default if this is empty — do not use that default outside local Docker).
PAYLOAD_SECRET=
SERVER_URL=http://localhost:3000

# --- Media storage (Google Cloud Storage) ---
# Leave both unset for local disk uploads (./media). Prefer that for day-to-day local work.
# On Cloud Run both must be set (container disk is not persistent). Auth is via Application
# Default Credentials — the Cloud Run service account in production, or
# `gcloud auth application-default login` locally.
# Do not point a local .env at production bucket names unless you deliberately intend to
# write there with constrained ADC credentials.
# GCS_BUCKET=
# GCS_RESUME_BUCKET=

# Example non-production names (only if you have matching buckets):
# GCS_BUCKET=itu-web-media
# GCS_RESUME_BUCKET=itu-web-resumes

# Résumés are private (job applications) — never expose the resume bucket with
# allUsers/allAuthenticatedUsers. GCS_RESUME_BUCKET is required whenever GCS_BUCKET is set.
