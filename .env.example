# Postgres (Supabase pooler, port 6543, pgbouncer)
DATABASE_URI=postgresql://postgres:[password]@[project].pooler.supabase.com:6543/postgres?pgbouncer=true

PAYLOAD_SECRET=replace-with-a-long-random-string

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage (S3-compatible)
S3_ENDPOINT=https://[project].supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=itu-web-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=[project].supabase.co

# Signed revalidation, called from Payload afterChange hooks
REVALIDATE_SECRET=replace-with-a-long-random-string

# Optional — contact/career email notifications no-op until this is set
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=no-reply@itusaha.com
